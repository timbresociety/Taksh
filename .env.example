# Server-side only. Without a key the app runs on labelled fixtures.
# The app uses 0G when OG_API_KEY is set, then Claude, then fixtures.

# 0G Compute Router key (sk-...) from pc.0g.ai -> Console -> API Keys. Requests run on the private (TEE) tier.
OG_API_KEY=
# Optional: a 0G model with a TeeML provider. Default glm-5.3.
# OG_MODEL=glm-5.3

# 0G Storage writer for rival episodes, on Galileo testnet. Fund it at faucet.0g.ai.
OG_STORAGE_PRIVATE_KEY=
# Optional overrides.
# OG_STORAGE_RPC=https://evmrpc-testnet.0g.ai
# OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

ANTHROPIC_API_KEY=

# Optional: override the default model.
# TAKSH_MODEL=claude-opus-5-5

# Optional: force one provider: 0g, claude or fixture.
# TAKSH_PROVIDER=fixture
