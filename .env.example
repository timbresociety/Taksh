# Server-side only. Without a key the app runs on labelled fixtures.

# GLM-5.3 (Z.ai). When set, it answers every model call: game ideas and player requests.
ZAI_API_KEY=
# Optional: GLM_MODEL=glm-5.3, GLM_BASE_URL=https://api.z.ai/api/paas/v4, GLM_TIMEOUT_MS=240000

# Claude, used when no GLM key is set.
ANTHROPIC_API_KEY=

# Optional: override the default Claude model.
# TAKSH_MODEL=claude-opus-5-5

# Optional: pick the provider: glm, or fixture to force fixtures even when a key is present.
# TAKSH_PROVIDER=fixture
# Optional, with fixtures: pretend each model call takes this long, to try the waiting screens.
# TAKSH_FIXTURE_DELAY_MS=4000
