# Server-side only. Without a key the app runs on labelled fixtures.
# The app uses 0G when OG_API_KEY is set, then Claude, then fixtures.

# 0G Compute Router key (sk-...) from pc.0g.ai -> Console -> API Keys. Requests run on the private (TEE) tier.
OG_API_KEY=
# Optional: a 0G model with a TeeML provider. Default glm-5.3.
# OG_MODEL=glm-5.3

# 0G Storage writer for rival episodes, on Galileo testnet. Fund it at faucet.0g.ai.
OG_STORAGE_PRIVATE_KEY=
# Optional overrides.
# OG_STORAGE_RPC=https://evmrpc-testnet.0g.ai
# OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

ANTHROPIC_API_KEY=

# Optional: override the default model.
# TAKSH_MODEL=claude-opus-5-5

# Optional: force one provider: 0g, claude or fixture.
# TAKSH_PROVIDER=fixture

# Arkiv (Rabdi testnet). Server-side only. Without a key the game plays and the board reads only.
ARKIV_PRIVATE_KEY=
# Optional: an access key from https://hub.arkiv.network/access-keys, to skip the rate-limited public RPC.
ARKIV_ACCESS_KEY=
# Optional: read another writer's board when no private key is set.
ARKIV_WRITER_ADDRESS=

# ENSv2 (Sepolia). Without these the games still play and publishing says it is unavailable.
# Second-level .eth name that games are published under, set up once with `npm run ens:setup`.
ENS_PARENT_NAME=
# Server-side wallet that issues game subnames. It holds only ROLE_REGISTRAR on the game registry.
ENS_REGISTRAR_PRIVATE_KEY=
# Owner of the parent name. Only `npm run ens:setup` uses it; the app never reads it.
ENS_OWNER_PRIVATE_KEY=
# Optional: RPC endpoint. Defaults to viem's public Sepolia RPC.
# ENS_RPC_URL=
# Optional: chain with an ENSv2 deployment in src/lib/ens/chain.js. Defaults to sepolia.
# ENS_CHAIN=sepolia
# Optional: ETH the setup sends the registrar for gas. Defaults to 0.01.
# ENS_REGISTRAR_TOPUP_ETH=

# Swarm on Gnosis mainnet: published games keep their cover and spec on Swarm, and the Arkiv entity
# holds the reference. Uploads need a Bee node and a postage batch (npm run swarm -- stamp). Reads go
# through the public gateway, so a deploy without a Bee node still shows covers. Unset = no Swarm.
BEE_URL=
SWARM_BATCH_ID=
# SWARM_GATEWAY=https://api.gateway.ethswarm.org
